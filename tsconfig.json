{
    "compilerOptions": { /* Base Options: */
        "esModuleInterop": true,
        "skipLibCheck": true,
        "target": "ES2022",
        "allowJs": true,
        "resolveJsonModule": true,
        "moduleDetection": "force",
        "isolatedModules": true, /* Strictness */
        "strict": true,
        "noUncheckedIndexedAccess": true, /* Module settings for Node.js ESM projects that use a bundler/runner like tsx */
        "module": "ESNext",
        "moduleResolution": "Bundler", /* Build options */
        "outDir": "dist",
        "rootDir": "src", /* Path alias: "@/x.js" -> "src/x.js". tsc-alias rewrites this back to
        relative specifiers in the compiled dist/ output (see package.json's build script) since plain
        `node dist/index.js` can't resolve "@/" at runtime; tsx and vitest resolve it directly.
        TypeScript 7 removed `baseUrl` — paths must be relative ("./src/*"), not bare ("src/*"). */
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}