generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // The default ESM output omits file extensions on relative imports, which Node's strict ESM
  // resolver rejects when running compiled output directly with `node` (not a bundler). This project
  // adds ".js" to all its own relative imports for the same reason — match it here too.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PresetTemplateTier {
  FREE
  PAID
}

enum PresetTemplateStatus {
  AVAILABLE
  PENDING
}

/// A curated, shared screener filter template shown to every user — not owned by anyone, unlike
/// ScreenerPreset (per-user, firebaseUid-scoped). Seeded from a competitor-research report
/// (2026-08-30, see prisma/seedPresetTemplates.ts) recommending named strategy templates (guru
/// strategies, quant factors, TW-specific chip signals, dividend/theme screens) as a discoverability
/// aid, matching how incumbents' preset libraries work. `filters` is plain JSON (not FK'd to
/// FilterMetricField like ScreenerPresetFilter) because a PENDING template's filters may reference a
/// metric this ecosystem doesn't compute yet — see `status`/`pendingReason`.
model PresetTemplate {
  id            String               @id @default(uuid()) @db.Uuid
  name          String               @unique
  category      String
  description   String
  tier          PresetTemplateTier
  status        PresetTemplateStatus
  /// Why this template can't actually run yet — required (and only meaningful) when status = PENDING.
  pendingReason String?              @map("pending_reason")
  /// Array of { field, min, max, exclude } — same shape POST /screener accepts. Empty for PENDING templates.
  filters       Json
  position      Int
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at")

  @@map("preset_template")
}

/// Filter catalog, synced from oingg-analysis-ts's /filters endpoint at startup (see src/domains/filterCatalog).
/// `position` mirrors this row's index in the source /filters array, so GET /filters on this service
/// can reproduce the same category/metric/field ordering the frontend would get from oingg-analysis-ts
/// directly — the source order matters for UX (e.g. "profitability" before more niche categories).
model FilterCategory {
  key      String         @id
  name     String
  position Int
  metrics  FilterMetric[]

  @@map("filter_category")
}

model FilterMetric {
  key         String              @map("key")
  categoryKey String              @map("category_key")
  name        String
  path        String
  /// Definition tooltip text for this metric — nullable until oingg-analysis-ts's /filters starts sending it.
  description String?
  /// Data-source tooltip text for this metric — nullable until oingg-analysis-ts's /filters starts sending it.
  source      String?
  position    Int
  category    FilterCategory      @relation(fields: [categoryKey], references: [key], onDelete: Cascade)
  fields      FilterMetricField[]

  @@id([key])
  @@map("filter_metric")
}

model FilterMetricField {
  metricKey String       @map("metric_key")
  key       String
  name      String
  period    String
  /// Definition tooltip text for this field — nullable until oingg-analysis-ts's /filters starts sending it.
  description String?
  /// Data-source tooltip text for this field — nullable until oingg-analysis-ts's /filters starts sending it.
  source      String?
  position  Int
  metric    FilterMetric @relation(fields: [metricKey], references: [key], onDelete: Cascade)

  presetFilters ScreenerPresetFilter[]

  @@id([metricKey, key])
  @@map("filter_metric_field")
}

/// Curated, product-defined column-preset templates (e.g. "存股領息", "獲利品質拆解"), synced from
/// oingg-analysis-ts's /filters endpoint at startup — same mechanism/rationale as FilterCategory above,
/// just a separate table since these aren't part of the category/metric/field catalog tree (see
/// src/domains/columnPresetTemplates). `fieldKeys` is a plain JSON string array of "<metricKey>.<fieldKey>"
/// refs, the same format ColumnPresetField.field uses — applying a template is just handing its fieldKeys
/// straight to createColumnPreset as a new personal ColumnPreset, not FK'd to FilterMetricField (so a
/// template referencing a field the catalog later drops doesn't cascade-delete anything here; it just
/// starts failing validation on apply, same as a hand-typed bad field would).
model ColumnPresetTemplate {
  key         String   @id
  name        String
  description String
  fieldKeys   Json     @map("field_keys")
  /// True on exactly one template (currently "overview"/總覽) — the neutral starting point the frontend
  /// shows before a user has picked anything. analysis-ts sends true on one template and omits the field
  /// on the rest; we don't enforce "exactly one true" here, that curation invariant is analysis-ts's.
  isDefault   Boolean  @default(false) @map("is_default")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("column_preset_template")
}

/// A minimal per-user profile row, keyed by Firebase uid (see src/domains/user, GET /users/me).
/// Read-only from this service's side — nothing here creates a row yet (no signup/first-login flow
/// exists), so a Firebase-authenticated caller with no row here still gets a 404 from /users/me.
/// Previously `findUserByFirebaseUid` looked this up via `queryNeon("main", ...)` against a
/// `MAIN_DATABASE_URL` Neon pool that was never configured in .env — every /users/me call threw
/// "No Neon database pool registered" instead of resolving one way or the other. Moved to live in this
/// service's own Prisma-managed DB instead, matching where every other per-user table already lives.
model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique @map("firebase_uid")
  email       String?
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("users")
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum ThemeAccentColor {
  BLUE
  GREEN
  PURPLE
  ORANGE
  RED
  TEAL
  GOLD
}

/// ASIA = red is up/gain, green is down/loss (台股/亞洲慣例); WESTERN = the reverse (歐美慣例); ACCESSIBLE =
/// colorblind-safe blue/orange (IBM palette, #648FFF/#FE6100) instead of red/green, chosen by the
/// frontend — this service doesn't own or validate the actual hex values, just the enum key.
enum MarketColorConvention {
  ASIA
  WESTERN
  ACCESSIBLE
}

/// A user's UI theme preference (see src/domains/user). All fields are nullable — null means
/// "not explicitly chosen, use the current system default" resolved live in the service layer (see
/// SYSTEM_DEFAULT_THEME in theme.service.ts), not frozen into this row at write time. That way a user
/// who only ever picked one field still tracks any future change to the default for the others, instead
/// of being stuck with whatever the default happened to be when their row was first created.
model UserThemePreference {
  firebaseUid           String                 @id @map("firebase_uid")
  mode                  ThemeMode?
  accentColor           ThemeAccentColor?      @map("accent_color")
  marketColorConvention MarketColorConvention? @map("market_color_convention")
  /// 視覺滿版 — whether the app's main content area spans full page width. App-wide layout preference,
  /// not tied to any one feature (e.g. not screener-specific, unlike ScreenerDisplaySettings).
  isFullWidth           Boolean?               @map("is_full_width")
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at")

  @@map("user_theme_preference")
}

/// A user's screener display preferences (see src/domains/user/screenerDisplaySettings.* — lives in the
/// user domain, not screener, since it's only usable by registered users, unlike the guest-friendly
/// screener endpoints themselves). Separate from
/// UserThemePreference (general UI look) and ScreenerPreset (saved filter combos)/ColumnPreset (saved
/// display columns) — this is about how a shown value renders, not which values/columns are shown.
/// showAsOfDate nullable — null means "not explicitly chosen, use the current system default" resolved
/// live in the service layer, same reasoning as UserThemePreference's fields.
model ScreenerDisplaySettings {
  firebaseUid  String   @id @map("firebase_uid")
  showAsOfDate Boolean? @map("show_as_of_date")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("screener_display_settings")
}

/// A user's stock watchlist (see src/domains/watchlist).
model WatchlistItem {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @map("firebase_uid")
  symbol      String
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([firebaseUid, symbol])
  @@index([firebaseUid])
  @@map("watchlist_item")
}

/// A user's named, reusable set of display columns for /screener results (see src/domains/screener) —
/// independent from ScreenerPreset (filter combos); a ScreenerPreset just remembers the last one it was
/// viewed with (see ScreenerPreset.lastColumnPreset). `field` is a plain string, not FK'd to
/// FilterMetricField, because it can also be a "special" non-catalog field (currently just
/// "stock.price", joined in from the twse/tpex price tables) — validity is checked in the service layer
/// instead. At most one preset per user should have `isDefault: true` (enforced in code, not the DB);
/// it's what /screener falls back to when no columnPresetId is given and there's no hardcoded fallback.
model ColumnPreset {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @map("firebase_uid")
  name        String
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  columns              ColumnPresetField[]
  lastViewedByScreener ScreenerPreset[]    @relation("LastColumnPreset")

  @@unique([firebaseUid, name])
  @@index([firebaseUid])
  @@map("column_preset")
}

model ColumnPresetField {
  id       Int    @id @default(autoincrement())
  presetId String @map("preset_id") @db.Uuid
  field    String
  position Int

  preset ColumnPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@index([presetId])
  @@map("column_preset_field")
}

/// A user's named, saved combination of screener filters (e.g. "績優股" = ROE > 30 AND grossMarginTtm >
/// 60) — see src/domains/screener. GET /screener/presets/:id/run re-runs the saved filters and returns
/// both the matching stocks and the filter definition in one response, so the frontend only needs the id.
model ScreenerPreset {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @map("firebase_uid")
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  filters ScreenerPresetFilter[]

  // Remembers whichever ColumnPreset this filter combo was last viewed with, so re-opening it
  // (GET /screener/presets/:id/run with no columnPresetId) shows the same columns as last time.
  lastColumnPresetId String?       @map("last_column_preset_id") @db.Uuid
  lastColumnPreset   ColumnPreset? @relation("LastColumnPreset", fields: [lastColumnPresetId], references: [id], onDelete: SetNull)

  @@unique([firebaseUid, name])
  @@index([firebaseUid])
  @@map("screener_preset")
}

/// A user's current position in a stock (持股管理) — maintained independently of StockTransaction,
/// not computed from it. Quantity/averageCost are whatever the user says they are; adjusting them after
/// recording a trade in StockTransaction is a separate, manual step (see src/domains/holdings).
model Holding {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @map("firebase_uid")
  symbol      String
  quantity    Int
  averageCost Decimal  @map("average_cost") @db.Decimal(18, 4)
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([firebaseUid, symbol])
  @@index([firebaseUid])
  @@map("holding")
}

enum TransactionAction {
  BUY
  SELL
}

/// A single buy/sell trade record (交易日誌) — a plain ledger entry, independent of Holding (see above).
model StockTransaction {
  id          String            @id @default(uuid()) @db.Uuid
  firebaseUid String            @map("firebase_uid")
  symbol      String
  action      TransactionAction
  quantity    Int
  price       Decimal           @db.Decimal(18, 4)
  fee         Decimal           @default(0) @db.Decimal(18, 4)
  tax         Decimal           @default(0) @db.Decimal(18, 4)
  tradeDate   DateTime          @map("trade_date") @db.Date
  note        String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")

  @@index([firebaseUid, tradeDate])
  @@map("stock_transaction")
}

/// One filter condition within a ScreenerPreset. References FilterMetricField for the same reason
/// ScreenerColumnPreference does — a saved filter can never point at a field the catalog doesn't have.
model ScreenerPresetFilter {
  id        Int     @id @default(autoincrement())
  presetId  String  @map("preset_id") @db.Uuid
  metricKey String  @map("metric_key")
  fieldKey  String  @map("field_key")
  min       Float?
  max       Float?
  exclude   Boolean @default(false)
  position  Int

  preset ScreenerPreset    @relation(fields: [presetId], references: [id], onDelete: Cascade)
  field  FilterMetricField @relation(fields: [metricKey, fieldKey], references: [metricKey, key], onDelete: Cascade)

  @@index([presetId])
  @@map("screener_preset_filter")
}
