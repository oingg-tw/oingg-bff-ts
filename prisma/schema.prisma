generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // The default ESM output omits file extensions on relative imports, which Node's strict ESM
  // resolver rejects when running compiled output directly with `node` (not a bundler). This project
  // adds ".js" to all its own relative imports for the same reason — match it here too.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Filter catalog, synced from oingg-analysis-ts's /filters endpoint at startup (see src/domains/filterCatalog).
/// `position` mirrors this row's index in the source /filters array, so GET /filters on this service
/// can reproduce the same category/metric/field ordering the frontend would get from oingg-analysis-ts
/// directly — the source order matters for UX (e.g. "profitability" before more niche categories).
model FilterCategory {
  key      String         @id
  name     String
  position Int
  metrics  FilterMetric[]

  @@map("filter_category")
}

model FilterMetric {
  key         String              @map("key")
  categoryKey String              @map("category_key")
  name        String
  path        String
  position    Int
  category    FilterCategory      @relation(fields: [categoryKey], references: [key], onDelete: Cascade)
  fields      FilterMetricField[]

  @@id([key])
  @@map("filter_metric")
}

model FilterMetricField {
  metricKey String       @map("metric_key")
  key       String
  name      String
  period    String
  position  Int
  metric    FilterMetric @relation(fields: [metricKey], references: [key], onDelete: Cascade)

  columnPreferences ScreenerColumnPreference[]
  presetFilters     ScreenerPresetFilter[]

  @@id([metricKey, key])
  @@map("filter_metric_field")
}

/// A user's stock watchlist (see src/domains/watchlist).
model WatchlistItem {
  id          Int      @id @default(autoincrement())
  firebaseUid String   @map("firebase_uid")
  symbol      String
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([firebaseUid, symbol])
  @@index([firebaseUid])
  @@map("watchlist_item")
}

/// A user's chosen display columns for /screener results (see src/domains/screener). References
/// FilterMetricField so a column preference can never point at a field that doesn't exist in the
/// catalog, and is auto-cleaned up (cascade) if oingg-analysis-ts ever removes that field/metric.
model ScreenerColumnPreference {
  id          Int      @id @default(autoincrement())
  firebaseUid String   @map("firebase_uid")
  metricKey   String   @map("metric_key")
  fieldKey    String   @map("field_key")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")

  field FilterMetricField @relation(fields: [metricKey, fieldKey], references: [metricKey, key], onDelete: Cascade)

  @@unique([firebaseUid, metricKey, fieldKey])
  @@index([firebaseUid])
  @@map("screener_column_preference")
}

/// A user's named, saved combination of screener filters (e.g. "績優股" = ROE > 30 AND grossMarginTtm >
/// 60) — see src/domains/screener. GET /screener/presets/:id/run re-runs the saved filters and returns
/// both the matching stocks and the filter definition in one response, so the frontend only needs the id.
model ScreenerPreset {
  id          Int      @id @default(autoincrement())
  firebaseUid String   @map("firebase_uid")
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  filters ScreenerPresetFilter[]

  @@unique([firebaseUid, name])
  @@index([firebaseUid])
  @@map("screener_preset")
}

/// One filter condition within a ScreenerPreset. References FilterMetricField for the same reason
/// ScreenerColumnPreference does — a saved filter can never point at a field the catalog doesn't have.
model ScreenerPresetFilter {
  id        Int     @id @default(autoincrement())
  presetId  Int     @map("preset_id")
  metricKey String  @map("metric_key")
  fieldKey  String  @map("field_key")
  min       Float?
  max       Float?
  exclude   Boolean @default(false)
  position  Int

  preset ScreenerPreset    @relation(fields: [presetId], references: [id], onDelete: Cascade)
  field  FilterMetricField @relation(fields: [metricKey, fieldKey], references: [metricKey, key], onDelete: Cascade)

  @@index([presetId])
  @@map("screener_preset_filter")
}
