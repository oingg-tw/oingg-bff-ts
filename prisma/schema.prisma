generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // The default ESM output omits file extensions on relative imports, which Node's strict ESM
  // resolver rejects when running compiled output directly with `node` (not a bundler). This project
  // adds ".js" to all its own relative imports for the same reason — match it here too.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PresetTemplateTier {
  FREE
  PAID
}

enum PresetTemplateStatus {
  AVAILABLE
  PENDING
}

/// A curated, shared screener filter template shown to every user — not owned by anyone, unlike
/// ScreenerPreset (per-user, firebaseUid-scoped). The 21 rows originally seeded from a
/// competitor-research report (2026-08-30) were all confirmed placeholder/demo data and deleted
/// 2026-09-08; the 7 real templates seeded since 2026-09-11 (see prisma/seedPresetTemplates.ts) are
/// grounded in metrics with real academic/methodology backing (GET /metrics' academicSourceUrl/badge
/// fields) instead. `filters` is plain JSON (not FK'd to MetricDefinitionField like
/// ScreenerPresetFilter) because a PENDING template's filters may reference a metric this ecosystem
/// doesn't compute yet — see `status`/`pendingReason`.
model PresetTemplate {
  id            String               @id @default(uuid()) @db.Uuid
  name          String               @unique
  /// Stable, URL-safe identifier decoupled from the editorial `name` above — added 2026-09-20 after
  /// renaming "股利穩健" -> "股利連續性" broke web-nuxt's routing (they were keying /screener/{slug} pages
  /// off `name`, the only string identifier available at the time). web-nuxt's own SCREENER_TEMPLATE_SLUGS
  /// is the authoritative source for these values — seeded to match exactly, not chosen independently.
  /// `name`/`description` can be revised freely now without notice; changing `slug` itself is still a
  /// breaking change for them and needs the same advance-notice treatment renaming `name` used to.
  slug          String               @unique
  category      String
  description   String
  tier          PresetTemplateTier
  status        PresetTemplateStatus
  /// Why this template can't actually run yet — required (and only meaningful) when status = PENDING.
  pendingReason String?              @map("pending_reason")
  /// Array of { field, min, max, exclude } — same shape POST /screener accepts. Empty for PENDING templates.
  filters       Json
  /// The template shown/pre-selected when a user opens the screener for the first time with no filters
  /// chosen yet — same isDefault convention as ColumnPresetTemplate, but purely a frontend discoverability
  /// signal here: unlike columns, bff-ts does NOT auto-apply this filter server-side (POST /screener still
  /// requires at least one explicit filter — see screener.service.ts's runScreener). Exactly one row
  /// should have this true, enforced by an assertion in prisma/seedPresetTemplates.ts, not the DB.
  isDefault     Boolean              @default(false) @map("is_default")
  position      Int
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at")

  @@map("preset_template")
}

/// Metric catalog, synced from oingg-analysis-ts's /metrics endpoint at startup (see
/// src/domainBusiness/metricCatalog — models renamed from Filter* to Metric* 2026-09-11, following through
/// on the /filters -> /metrics rename from 2026-09-10 that only touched the public route at the time:
/// the response is metric definitions, not filters, and the DB/domain layer should say so too, for
/// ubiquitous language). `position` mirrors this row's index in the source array, so GET /metrics on this
/// service can reproduce the same category/metric/field ordering the frontend would get from
/// oingg-analysis-ts directly — the source order matters for UX (e.g. "profitability" before more niche
/// categories).
model MetricCategory {
  key      String             @id
  name     String
  position Int
  metrics  MetricDefinition[]

  @@map("metric_category")
}

model MetricDefinition {
  key         String                    @map("key")
  categoryKey String                    @map("category_key")
  name        String
  path        String
  /// Definition tooltip text for this metric — analysis-ts started actually sending this 2026-09-19 (the
  /// column existed since launch but was always null before that — they never populated the field).
  description String?
  /// Data-source tooltip text for this metric — nullable until oingg-analysis-ts's /metrics starts sending it.
  source      String?
  /// What this metric can't tell you (e.g. sample-size caveats, survivorship bias) — added by analysis-ts
  /// 2026-09-19, alongside description/misreadings. Present on the ~35 badge-bearing metrics at launch;
  /// null on the rest until analysis-ts documents more.
  limitations String?
  /// Common ways this metric gets misread/misapplied — added by analysis-ts 2026-09-19, same badge-
  /// metrics-first coverage as limitations.
  misreadings String?
  /// Display unit for this metric's values (e.g. "percent", "currency", "times", "ratio") — a field's own
  /// unit (below) overrides this when set, same fallback convention as description/source.
  unit        String?
  /// LaTeX source for this metric's formula, read-only display only (e.g. KaTeX/mathlive) — never for
  /// actual computation (analysis-ts's real figures are bigint-precise, LaTeX compute engines are float-
  /// based). Nullable — analysis-ts only documents a formula for a handful of metrics as of 2026-09-10
  /// (pilot rollout), absent entirely from their /metrics response for the rest, not an empty string.
  formulaLatex String?                  @map("formula_latex")
  /// URL to an external reference explaining this metric (e.g. a Wikipedia article) — same "not every
  /// metric has one yet" convention as formulaLatex. Lets web-nuxt drop its own hardcoded per-metric
  /// source-link table (guru-badges.ts) and just render whatever analysis-ts's MetricDefinitionSpec
  /// already declares, added 2026-09-10.
  referenceUrl String?                  @map("reference_url")
  /// URL to the original academic paper (author/year/journal) behind this metric's methodology — distinct
  /// from `referenceUrl` above, which is a general-reader explanation (often Wikipedia). analysis-ts's own
  /// words: "referenceUrl 給一般讀者看的白話解釋，academicSourceUrl 給想找原始論文的人". Nullable — set on only
  /// ~13 curated "guru badge" methodologies (sue, the Basel III/IMF FSI banking ratios, etc.) as of
  /// 2026-09-10, same sparse-coverage pattern referenceUrl started with.
  academicSourceUrl String?             @map("academic_source_url")
  /// Curated "guru badge" methodology threshold (whole object: id/name/author/summary/detail/token/
  /// threshold), moved from web-nuxt's own hardcoded GURU_BADGES table into analysis-ts's
  /// MetricDefinitionSpec 2026-09-10 and echoed back here. Nullable — present on only the ~11 metrics that
  /// table covered; Piotroski F-Score deliberately excluded by mutual agreement, stays frontend-hardcoded.
  badge       Json?
  /// Data-provenance category labels (e.g. "公開發行公司資產負債表（XBRL）") — a fixed 9-label vocabulary on
  /// analysis-ts's side, distinct from the free-text `source` tooltip field above (which analysis-ts has
  /// never populated). Unlike formulaLatex/referenceUrl/badge, analysis-ts guarantees this is always
  /// present and non-empty for every metric (added 2026-09-10) — not a "not every metric has one yet"
  /// field. Defaults to an empty array only defensively (a metric genuinely missing this from
  /// analysis-ts's response is a validation error at the client layer, not silently tolerated here).
  sources     String[]                  @default([])
  /// Whether this metricCode supports GET /companies/:symbol/metric-provenance (the raw-filing audit
  /// trail behind a computed value) — added by analysis-ts 2026-09-13, a growing allowlist (12 metrics at
  /// launch: sue/chowderNumber/roe/accrualsRatio/dividendPayoutRatio/altmanZScore/dupontTaxBurden/
  /// dupontInterestBurden/inventoryTurnover/receivablesTurnover/fixedAssetTurnover/payablesTurnover).
  /// Read off this field rather than hardcoding the list, since analysis-ts said coverage will keep
  /// expanding. Defaults to false for any metric predating this field (there is no "unknown" state).
  hasProvenance Boolean                 @default(false) @map("has_provenance")
  /// The metric's current formula version, mirrored from analysis-ts's GET /metrics (added 2026-09-22) —
  /// the same integer stamped on every metric_values row they compute, so consumers can detect when a
  /// metric's numbers changed meaning. Defaults to 1 only for rows predating the column; the sync always
  /// writes the real value (missing/non-integer upstream fails validation at the client layer).
  formulaVersion Int                    @default(1) @map("formula_version")
  position    Int
  category    MetricCategory            @relation(fields: [categoryKey], references: [key], onDelete: Cascade)
  fields      MetricDefinitionField[]

  @@id([key])
  @@map("metric_definition")
}

model MetricDefinitionField {
  metricKey String           @map("metric_key")
  key       String
  name      String
  period    String
  /// Definition tooltip text for this field — nullable until oingg-analysis-ts's /metrics starts sending it.
  description String?
  /// Data-source tooltip text for this field — nullable until oingg-analysis-ts's /metrics starts sending it.
  source      String?
  /// Display unit for this specific field (e.g. dupont.assetTurnoverQuarterly is "times" even though the
  /// dupont metric's own default unit is "percent") — falls back to the metric's unit when not set.
  unit        String?
  position  Int
  metric    MetricDefinition @relation(fields: [metricKey], references: [key], onDelete: Cascade)

  presetFilters ScreenerPresetFilter[]

  @@id([metricKey, key])
  @@map("metric_definition_field")
}

/// Curated, product-defined column-preset templates (e.g. "存股領息", "獲利品質拆解"), synced from
/// oingg-analysis-ts's /metrics endpoint at startup — same mechanism/rationale as MetricCategory above,
/// just a separate table since these aren't part of the category/metric/field catalog tree (see
/// src/domainBusiness/columnPresetTemplates). `fieldKeys` is a plain JSON string array of "<metricKey>.<fieldKey>"
/// refs, the same format ColumnPresetField.field uses — applying a template is just handing its fieldKeys
/// straight to createColumnPreset as a new personal ColumnPreset, not FK'd to MetricDefinitionField (so a
/// template referencing a field the catalog later drops doesn't cascade-delete anything here; it just
/// starts failing validation on apply, same as a hand-typed bad field would).
model ColumnPresetTemplate {
  key         String   @id
  name        String
  description String
  fieldKeys   Json     @map("field_keys")
  /// True on exactly one template (currently "overview"/總覽) — the neutral starting point the frontend
  /// shows before a user has picked anything. analysis-ts sends true on one template and omits the field
  /// on the rest; we don't enforce "exactly one true" here, that curation invariant is analysis-ts's.
  isDefault   Boolean  @default(false) @map("is_default")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("column_preset_template")
}

/// A minimal per-user profile row, keyed by Firebase uid (see src/domainBusiness/user, GET /users/me).
/// Read-only from this service's side — nothing here creates a row yet (no signup/first-login flow
/// exists), so a Firebase-authenticated caller with no row here still gets a 404 from /users/me.
/// Previously `findUserByFirebaseUid` looked this up via `queryNeon("main", ...)` against a
/// `MAIN_DATABASE_URL` Neon pool that was never configured in .env — every /users/me call threw
/// "No Neon database pool registered" instead of resolving one way or the other. Moved to live in this
/// service's own Prisma-managed DB instead, matching where every other per-user table already lives.
model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique @map("firebase_uid")
  email       String?
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("users")
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum ThemeAccentColor {
  BLUE
  GREEN
  PURPLE
  ORANGE
  RED
  TEAL
  GOLD
}

/// ASIA = red is up/gain, green is down/loss (台股/亞洲慣例); WESTERN = the reverse (歐美慣例); ACCESSIBLE =
/// colorblind-safe blue/orange (IBM palette, #648FFF/#FE6100) instead of red/green, chosen by the
/// frontend — this service doesn't own or validate the actual hex values, just the enum key.
enum MarketColorConvention {
  ASIA
  WESTERN
  ACCESSIBLE
}

/// A user's UI theme preference (see src/domainBusiness/user). All fields are nullable — null means
/// "not explicitly chosen, use the current system default" resolved live in the service layer (see
/// SYSTEM_DEFAULT_THEME in theme.service.ts), not frozen into this row at write time. That way a user
/// who only ever picked one field still tracks any future change to the default for the others, instead
/// of being stuck with whatever the default happened to be when their row was first created.
model UserThemePreference {
  firebaseUid           String                 @id @map("firebase_uid")
  mode                  ThemeMode?
  accentColor           ThemeAccentColor?      @map("accent_color")
  marketColorConvention MarketColorConvention? @map("market_color_convention")
  /// 視覺滿版 — whether the app's main content area spans full page width. App-wide layout preference,
  /// not tied to any one feature (e.g. not screener-specific, unlike ScreenerDisplaySettings).
  isFullWidth           Boolean?               @map("is_full_width")
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at")

  @@map("user_theme_preference")
}

/// A user's screener display preferences (see src/domainBusiness/user/screenerDisplaySettings.* — lives in the
/// user domain, not screener, since it's only usable by registered users, unlike the guest-friendly
/// screener endpoints themselves). Separate from
/// UserThemePreference (general UI look) and ScreenerPreset (saved filter combos)/ColumnPreset (saved
/// display columns) — this is about how a shown value renders, not which values/columns are shown.
/// showAsOfDate nullable — null means "not explicitly chosen, use the current system default" resolved
/// live in the service layer, same reasoning as UserThemePreference's fields.
model ScreenerDisplaySettings {
  firebaseUid  String   @id @map("firebase_uid")
  showAsOfDate Boolean? @map("show_as_of_date")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("screener_display_settings")
}

/// Which homepage dashboard cards a user has shown/hidden (see src/domainBusiness/user/dashboardCardSettings.*)
/// — previously local-only client state (oingg-web-nuxt's useDashboardCards.ts useState, reset per
/// device), now synced across devices. `visibleCardIds` is a plain JSON string array of frontend-owned
/// card ids (e.g. "margin-short-ratio", "revenue-ranking") — not FK'd to anything, since the set of
/// valid ids is a growing, frontend-defined list this service doesn't validate membership against; an id
/// the frontend later retires just becomes inert data here. No row at all (not an empty array) means "no
/// preference saved yet" — resolved to the frontend's own default list client-side, since bff-ts has no
/// way to know what that current full list is.
model DashboardCardSettings {
  firebaseUid    String   @id @map("firebase_uid")
  visibleCardIds Json     @map("visible_card_ids")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("dashboard_card_settings")
}

/// 卡片 vs. 會計 — oingg-web-nuxt's /stock/[code].vue layout mode. Was a 3-way 簡易/專家/會計 choice until
/// 2026-09-07, collapsed to 2-way since 簡易/專家 never actually differentiated content.
enum StockDetailPageMode {
  CARD
  ACCOUNTING
}

/// A user's /stock/[code].vue display preferences (see src/domainBusiness/user/stockDetailPreferences.*)
/// — previously local-only client state (Vue useState, lost on reload), now synced across devices, same
/// pattern as DashboardCardSettings above. `visibleCardIds` is a plain JSON string array of frontend-owned
/// info-card ids (profile/per-river/pbr-river/eps/revenue/share-capital/ex-dividend) — not FK'd to
/// anything, same reasoning as DashboardCardSettings.visibleCardIds. Both fields are always written
/// together (the settings popover saves the whole thing at once, see updateStockDetailPreferences) — no
/// row at all means "no preference saved yet" for both, resolved to the frontend's own local default.
model StockDetailPreferences {
  firebaseUid    String              @id @map("firebase_uid")
  mode           StockDetailPageMode
  visibleCardIds Json                @map("visible_card_ids")
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at")

  @@map("stock_detail_preferences")
}

/// Which column-preset tab is selected on /preferred-stocks' table (全部欄位/契約條款/估值指標/贖回風險).
/// SCREAMING_SNAKE_CASE for the multi-word values — no other enum in this schema has a multi-word value,
/// this is the pattern to follow if one comes up again.
enum PreferredStocksColumnPreset {
  ALL
  CONTRACT_TERMS
  VALUATION
  CALL_RISK
}

/// A user's /preferred-stocks display preferences (see
/// src/domainBusiness/user/preferredStocksPreferences.*) — previously local-only client state (Vue
/// useState, lost on reload), now synced across devices, same pattern as StockDetailPreferences above.
/// `columnOrder` is a plain JSON string array of frontend-owned column ids (e.g. "dividend-type",
/// "issue-price") for the drag-reorderable table — not FK'd to anything, same reasoning as
/// DashboardCardSettings.visibleCardIds. Both fields are always written together (the settings UI saves
/// both at once) — no row at all means "no preference saved yet" for both, resolved to the frontend's
/// own local default.
model PreferredStocksPreferences {
  firebaseUid    String                      @id @map("firebase_uid")
  columnPresetId PreferredStocksColumnPreset @map("column_preset_id")
  columnOrder    Json                        @map("column_order")
  updatedAt      DateTime                    @default(now()) @updatedAt @map("updated_at")

  @@map("preferred_stocks_preferences")
}

/// A user's stock watchlist (see src/domainBusiness/watchlist).
model WatchlistItem {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @map("firebase_uid")
  symbol      String
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([firebaseUid, symbol])
  @@index([firebaseUid])
  @@map("watchlist_item")
}

/// A user's named, reusable set of display columns for /screener results (see src/domainBusiness/screener) —
/// independent from ScreenerPreset (filter combos); a ScreenerPreset just remembers the last one it was
/// viewed with (see ScreenerPreset.lastColumnPreset). `field` is a plain string, not FK'd to
/// MetricDefinitionField, because it can also be a "special" non-catalog field (currently just
/// "stock.price", joined in from the twse/tpex price tables) — validity is checked in the service layer
/// instead. At most one preset per user should have `isDefault: true` (enforced in code, not the DB);
/// it's what /screener falls back to when no columnPresetId is given and there's no hardcoded fallback.
model ColumnPreset {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @map("firebase_uid")
  name        String
  isDefault   Boolean  @default(false) @map("is_default")
  /// User-controlled display order of this preset among the caller's own tabs (2026-09-11, drag-to-reorder
  /// UI) — distinct from ColumnPresetField.position, which orders the columns WITHIN one preset. Assigned
  /// at creation time (appended to the end of the caller's own list) and only otherwise changed via the
  /// dedicated POST /screener/column-presets/reorder endpoint, which requires the full ordered id set (not
  /// a single position patch) so positions never collide or leave gaps.
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  columns              ColumnPresetField[]
  lastViewedByScreener ScreenerPreset[]    @relation("LastColumnPreset")

  @@unique([firebaseUid, name])
  @@index([firebaseUid])
  @@map("column_preset")
}

model ColumnPresetField {
  id       Int    @id @default(autoincrement())
  presetId String @map("preset_id") @db.Uuid
  field    String
  position Int

  preset ColumnPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@index([presetId])
  @@map("column_preset_field")
}

/// A user's named, saved combination of screener filters (e.g. "績優股" = ROE > 30 AND grossMarginTtm >
/// 60) — see src/domainBusiness/screener. GET /screener/presets/:id/run re-runs the saved filters and returns
/// both the matching stocks and the filter definition in one response, so the frontend only needs the id.
model ScreenerPreset {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @map("firebase_uid")
  name        String
  /// User-controlled display order among the caller's own filter-combo tabs (2026-09-11, drag-to-reorder
  /// UI) — same convention as ColumnPreset.position. Assigned at creation time and only otherwise changed
  /// via POST /screener/presets/reorder.
  position    Int      @default(0)
  /// TWSE/TPEx securities-sector codes (證交所類股, e.g. "24") this preset filters to, as a plain JSON
  /// string array — not FK'd to a local catalog, since analysis-ts (GET /industries/securities-sectors)
  /// is the sole validation authority here, same reasoning as DashboardCardSettings.visibleCardIds. An
  /// invalid/retired code saved here is only caught when the preset is actually run (GET
  /// /screener/presets/:id/run calls analysis-ts's POST /screener), not at save time. Empty array means
  /// no sector restriction.
  sectorCodes Json     @default("[]") @map("sector_codes")
  /// Symmetric with sectorCodes above ("every sector except these"), added 2026-09-20 — same plain-JSON,
  /// analysis-ts-is-sole-authority convention. Mutually exclusive with sectorCodes at the API layer (not
  /// a DB constraint) — enforced in screenerPresets.service.ts, not here, same as every other cross-field
  /// validation in this codebase.
  excludeSectorCodes Json @default("[]") @map("exclude_sector_codes")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  filters ScreenerPresetFilter[]

  // Remembers whichever ColumnPreset this filter combo was last viewed with, so re-opening it
  // (GET /screener/presets/:id/run with no columnPresetId) shows the same columns as last time.
  lastColumnPresetId String?       @map("last_column_preset_id") @db.Uuid
  lastColumnPreset   ColumnPreset? @relation("LastColumnPreset", fields: [lastColumnPresetId], references: [id], onDelete: SetNull)

  @@unique([firebaseUid, name])
  @@index([firebaseUid])
  @@map("screener_preset")
}

/// A user's current position in a stock (持股管理) — maintained independently of StockTransaction,
/// not computed from it. Quantity/averageCost are whatever the user says they are; adjusting them after
/// recording a trade in StockTransaction is a separate, manual step (see src/domainBusiness/holdings).
model Holding {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @map("firebase_uid")
  symbol      String
  quantity    Int
  averageCost Decimal  @map("average_cost") @db.Decimal(18, 4)
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([firebaseUid, symbol])
  @@index([firebaseUid])
  @@map("holding")
}

enum TransactionAction {
  BUY
  SELL
}

/// A single buy/sell trade record (交易日誌) — a plain ledger entry, independent of Holding (see above).
model StockTransaction {
  id          String            @id @default(uuid()) @db.Uuid
  firebaseUid String            @map("firebase_uid")
  symbol      String
  action      TransactionAction
  quantity    Int
  price       Decimal           @db.Decimal(18, 4)
  fee         Decimal           @default(0) @db.Decimal(18, 4)
  tax         Decimal           @default(0) @db.Decimal(18, 4)
  tradeDate   DateTime          @map("trade_date") @db.Date
  note        String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")

  @@index([firebaseUid, tradeDate])
  @@map("stock_transaction")
}

/// One filter condition within a ScreenerPreset. References MetricDefinitionField for the same reason
/// ScreenerColumnPreference does — a saved filter can never point at a field the catalog doesn't have.
model ScreenerPresetFilter {
  id        Int     @id @default(autoincrement())
  presetId  String  @map("preset_id") @db.Uuid
  metricKey String  @map("metric_key")
  fieldKey  String  @map("field_key")
  min       Float?
  max       Float?
  exclude   Boolean @default(false)
  position  Int

  preset ScreenerPreset         @relation(fields: [presetId], references: [id], onDelete: Cascade)
  field  MetricDefinitionField  @relation(fields: [metricKey, fieldKey], references: [metricKey, key], onDelete: Cascade)

  @@index([presetId])
  @@map("screener_preset_filter")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// 這期結束後會不會自己續下去。刻意是獨立欄位而不是從 providerPeriodNo 是否為 null 推論——手動授予
/// （provider = MANUAL）同樣沒有週期單號，推論會把它誤判成「會自動續」，而那正是最不該誤判的一種。
enum RenewalMode {
  /// 信用卡定期定額：金流商那邊有合約，每期自動扣款並回呼，使用者什麼都不用做。
  AUTOMATIC
  /// ATM 虛擬帳號／超商代碼的一次性年繳：金流商那邊沒有任何合約，到期就是到期。中高齡族群對自動續扣
  /// 有戒心，這條路徑是必備而非選配，所以它的「到期前要主動提醒」是產品責任，不是邊緣案例。
  MANUAL
}

enum BillingProvider {
  NEWEBPAY
  /// Granted by hand (support, comp, internal testing) rather than by a payment provider — kept
  /// distinct so a manual grant is never mistaken for a real paid conversion in any future reporting.
  MANUAL
}

/// A user's paid entitlement. **Absence of a row means FREE** — free users are never materialized here
/// (see the system-defaults-as-code rule: a free tier is the live default, not a stored row), so this
/// table only ever holds people who have actually transacted.
///
/// Written exclusively by the billing webhook / manual grants — no user-facing endpoint may create or
/// modify a row here, or a caller could grant themselves a subscription.
///
/// Compliance note (投信投顧法): this row may only ever gate 查詢廣度 / 歷史深度 / 匯出推播效率. It must
/// never reach the stock-detail assembly path — analysis content is identical for every tier, so that a
/// downgraded user opening the same company sees exactly what they saw while paying. See
/// billing/quota.ts for the enforced list.
model Subscription {
  firebaseUid      String             @id @map("firebase_uid")
  status           SubscriptionStatus
  /// Plan identifier (e.g. "pro-monthly") — a plain string, not an enum, so adding a price point
  /// doesn't need a migration in a service that isn't the source of truth for the price list.
  plan             String
  /// Access runs until this moment even after a cancellation, which is why entitlement is
  /// (status, currentPeriodEnd) and not status alone.
  currentPeriodEnd DateTime           @map("current_period_end")
  provider         BillingProvider
  /// 預設 MANUAL 是刻意選擇的失效方向：猜錯成 MANUAL 只會多寄一封提醒，猜錯成 AUTOMATIC 會讓使用者
  /// 等一筆永遠不會發生的扣款，然後在毫無預警下被降級。
  renewalMode      RenewalMode        @default(MANUAL) @map("renewal_mode")
  /// The provider's own subscription id — NewebPay's PeriodNo (週期單號). Unique so a replayed
  /// webhook can't create a second subscription for the same provider-side agreement.
  providerPeriodNo String?            @unique @map("provider_period_no")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")

  @@map("subscription")
}
