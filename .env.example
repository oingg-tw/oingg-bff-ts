# Server
PORT=4000
NODE_ENV=development

# Firebase Admin
# Download a service account key from Firebase Console > Project Settings > Service Accounts
# and save it as serviceAccountKey.json in the project root (gitignored). Only set this if
# you want to use a different path.
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Neon databases
# Add one NEON_DB_<NAME>_URL per database this service reads from.
# <NAME> becomes the pool name used with getNeonPool()/queryNeon(), e.g. "main" below.
NEON_DB_MAIN_URL=postgres://user:password@ep-example.neon.tech/main?sslmode=require
# NEON_DB_ANALYTICS_URL=postgres://user:password@ep-example.neon.tech/analytics?sslmode=require
