# Server
PORT=4000
NODE_ENV=development
# Comma-separated CORS allowlist for browser-based frontends. Defaults to http://localhost:3000 if unset.
CORS_ORIGINS=http://localhost:3000

# Firebase Admin
# Download a service account key from Firebase Console > Project Settings > Service Accounts
# and save it as serviceAccountKey.json in the project root (gitignored). Only set this if
# you want to use a different path.
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Neon databases
# Add one NEON_DB_<NAME>_URL per database this service reads from.
# <NAME> becomes the pool name used with getNeonPool()/queryNeon().
# Use sslmode=verify-full, not require: pg currently treats require/prefer/verify-ca as verify-full
# anyway, so this just pins today's behavior down explicitly and avoids a pg-connection-string warning.
NEON_DB_MAIN_URL=postgres://user:password@ep-example.neon.tech/main?sslmode=verify-full
# NEON_DB_MOPS_URL=...     # oingg-mops-ts (MOPS quarterly financial reports)
# NEON_DB_TWSE_URL=...     # oingg-twse-ts (上市每日價格/估值)
# NEON_DB_TPEX_URL=...     # oingg-tpex-ts (上櫃每日價格/估值)
# NEON_DB_ANALYSIS_URL=... # oingg-analysis-ts 自己擁有 schema 的第二個 DB（算好的投資指標結果）

# oingg-analysis-ts 的 /filters 端點，啟動時抓取分類/指標/欄位目錄存進 APP_DATABASE_URL
FILTERS_SERVICE_URL=http://localhost:5000

# app = oingg-bff-ts 自己擁有 schema 的資料庫（Prisma 管理，filter catalog、未來的 users/持股資料都放這裡）
APP_DATABASE_URL=postgres://user:password@ep-example-pooler.neon.tech/main?sslmode=verify-full&pgbouncer=true
APP_DIRECT_URL=postgres://user:password@ep-example.neon.tech/main?sslmode=verify-full
