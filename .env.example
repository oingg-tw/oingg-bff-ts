# Server
PORT=3000
NODE_ENV=development

# Firebase Admin (from a service account JSON key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n line breaks; they are restored to real newlines at runtime.
FIREBASE_PRIVATE_KEY=

# Neon databases
# Add one NEON_DB_<NAME>_URL per database this service reads from.
# <NAME> becomes the pool name used with getNeonPool()/queryNeon(), e.g. "main" below.
NEON_DB_MAIN_URL=postgres://user:password@ep-example.neon.tech/main?sslmode=require
# NEON_DB_ANALYTICS_URL=postgres://user:password@ep-example.neon.tech/analytics?sslmode=require
