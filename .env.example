# Server
PORT=4000
NODE_ENV=development
# Comma-separated CORS allowlist for browser-based frontends. Defaults to http://localhost:3000 if unset.
# 3000 = local dev frontend, 3080 = frontend agent's dev server, oingg.com = planned production domain
# (allowlisted ahead of time so go-live doesn't need a CORS config change on top of everything else).
CORS_ORIGINS=http://localhost:3000,http://localhost:3080,https://oingg.com

# Firebase Admin
# Download a service account key from Firebase Console > Project Settings > Service Accounts
# and save it as serviceAccountKey.json in the project root (gitignored). Only set this if
# you want to use a different path.
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Firebase Web API Key (Project Settings > General > Your apps > Web API Key) — NOT a secret, it's
# baked into every browser bundle on the frontend. This backend only needs it for
# scripts/security-check.ts, to sign in its own ephemeral test accounts via Firebase's REST API.
FIREBASE_WEB_API_KEY=AIzaSy...

# Neon databases (raw pg pool registry — see src/adapters/neon/pool.ts)
# Add one <NAME>_DATABASE_URL per database this service reads from via queryNeon().
# <NAME> becomes the pool name used with getNeonPool()/queryNeon(). Discovery matches
# `<NAME>_DATABASE_URL` for any <NAME> — the bare `DATABASE_URL` below (this service's own,
# Prisma-managed DB) naturally doesn't match (no `<NAME>_` prefix), so it's never swept in.
# Use sslmode=verify-full, not require: pg currently treats require/prefer/verify-ca as verify-full
# anyway, so this just pins today's behavior down explicitly and avoids a pg-connection-string warning.
#
# TWSE_DATABASE_URL/TPEX_DATABASE_URL/ANALYSIS_DATABASE_URL deliberately absent: bff-ts may only talk to
# oingg-analysis-ts via its API, never directly to any database it doesn't own itself — see
# docs/業務中台與後台資料邊界架構.md. No <NAME>_DATABASE_URL is currently registered at all; this section
# is left as documentation for if/when this service ever legitimately owns a second external DB again.

# oingg-analysis-ts 的 /filters 端點，啟動時抓取分類/指標/欄位目錄存進 DATABASE_URL。oingg-analysis-ts
# 不會主動通知這個服務有變動（數據中台不知道業務中台存在），所以拉取只在啟動時發生。
FILTERS_SERVICE_URL=http://localhost:5000

# analysis-ts 2026-09-04 起要求所有 domainApi 請求帶 X-Api-Key header（健康檢查 / 跟 /batch/compute 除外）。
# 跟 analysis-ts 要這把本機開發用的金鑰；正式環境會換成 Secret Manager 管理的另一組值，屆時另行同步。
BFF_API_KEY=

# 本服務自己擁有 schema 的資料庫（Prisma 管理，filter catalog、users、持股/交易日誌資料都放這裡）
# runtime 用（host 帶 -pooler）
DATABASE_URL=postgres://user:password@ep-example-pooler.neon.tech/main?sslmode=verify-full&pgbouncer=true
# migration 用（不帶 -pooler）
DIRECT_URL=postgres://user:password@ep-example.neon.tech/main?sslmode=verify-full
